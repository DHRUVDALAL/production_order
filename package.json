{
  "name": "order-management-portal",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds": "^10",
    "docx": "^9.7.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": "sqlite",
      "ZAPI_PRODUCTION_ORDER_2_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/ZAPI_PRODUCTION_ORDER_2_SRV",
        "credentials": {
          "url": "https://my421238-api.s4hana.cloud.sap/sap/opu/odata/sap/API_PRODUCTION_ORDER_2_SRV",
          "authentication": "BasicAuthentication"
        },
        "csrf": true,
        "csrfInBatch": true,
        "orderType": "ZPPS"
      },
      "ZAPI_MATERIAL_DOCUMENT_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/ZAPI_MATERIAL_DOCUMENT_SRV",
        "credentials": {
          "url": "https://my421238-api.s4hana.cloud.sap/sap/opu/odata/sap/API_MATERIAL_DOCUMENT_SRV",
          "authentication": "BasicAuthentication"
        },
        "csrf": true,
        "csrfInBatch": true
      },
      "API_PROD_ORDER_CONFIRMATION_2_SRV": {
        "kind": "odata-v2",
        "model": "srv/external/API_PROD_ORDER_CONFIRMATION_2_SRV",
        "credentials": {
          "url": "https://my421238-api.s4hana.cloud.sap/sap/opu/odata/sap/API_PROD_ORDER_CONFIRMATION_2_SRV",
          "authentication": "BasicAuthentication"
        },
        "csrf": true,
        "csrfInBatch": true
      }
    },
    "cors": {
      "origin": "*"
    }
  }
}
